    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">Fork med kildeseparation</string>
    <string name="about_booming_ss_summary">Booming SS er en uofficiel version baseret på Booming Music med kildeseparation. Den bevarer den oprindelige oplevelse som lokal musikafspiller og tilføjer separat afspilning, sporblandingskontroller, blandingshukommelse pr. sang og administration af separerede caches.</string>
    <string name="about_booming_ss_model_title">Modelfiler</string>
    <string name="about_booming_ss_model_summary">Kildeseparationsmodeller følger ikke med appen. Du kan hente en forudindstillet model, bruge en brugerdefineret URL eller importere en lokal TFLite-fil. Hashkontroller vises kun som vejledning og blokerer ikke brugen.</string>
    <string name="about_booming_ss_fork_title">Booming SS-kildekode</string>
    <string name="about_booming_ss_fork_summary">Åbn denne fork på GitHub for ændringer til kildeseparation, udgivelser og fejlrapporter. Hvis det samme problem også sker i den originale Booming Music-app, skal du rapportere det til upstream-repositoriet.</string>
    <string name="about_booming_ss_upstream_title">Original Booming Music</string>
    <string name="about_booming_ss_upstream_summary">Se upstream-projektet af Christians Martínez Alvarado og bidragydere.</string>
    <string name="about_booming_music_original_author_title">Oprindelig forfatter af Booming Music</string>
    <string name="about_booming_ss_report_bugs_dialog_message">Booming SS bruger sit eget repository til ændringer i kildeseparation og fork-specifikke problemer. Hvis det samme problem også sker i den originale Booming Music-app uden Booming SS-funktioner, skal du i stedet rapportere det til upstream-repositoriet.</string>
    <string name="about_booming_ss_translate_dialog_message">Lokaliseringen af det originale Booming Music administreres på Hosted Weblate. Det projekt indeholder ikke Booming SS-tekster til kildeseparation. Brug kun dette link til oversættelser af upstream-appen. Booming SS-specifikke oversættelser vedligeholdes separat i denne fork.</string>
    <string name="source_separation_panel_entry_title">Adgang til kildeseparationspanel</string>
    <string name="source_separation_panel_entry_summary">Vis afspillerknappen og menupunktet for kildeseparationspanelet.</string>
    <string name="source_separation_quick_controls_title">Hurtigkontroller til kildeseparation</string>
    <string name="source_separation_quick_controls_summary">Vis genvejen til sporblanding over sangteksterne i afspilleren.</string>
