    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">Fork med kildeseparasjon</string>
    <string name="about_booming_ss_summary">Booming SS er en uoffisiell versjon basert på Booming Music med kildeseparasjon. Den beholder den opprinnelige opplevelsen som lokal musikkspiller og legger til separert avspilling, kontroller for spormiks, miksminne per sang og administrasjon av separerte hurtigbuffere.</string>
    <string name="about_booming_ss_model_title">Modellfiler</string>
    <string name="about_booming_ss_model_summary">Kildeseparasjonsmodeller følger ikke med appen. Du kan laste ned en forhåndsinnstilt modell, bruke en egendefinert URL eller importere en lokal ONNX-fil. Hashkontroller vises bare som veiledning og blokkerer ikke bruk.</string>
    <string name="about_booming_ss_fork_title">Booming SS-kildekode</string>
    <string name="about_booming_ss_fork_summary">Åpne denne forken på GitHub for kildeseparasjonsendringer, utgivelser og feilrapporter. Hvis samme problem også skjer i den originale Booming Music-appen, rapporter det til upstream-repositoriet.</string>
    <string name="about_booming_ss_upstream_title">Original Booming Music</string>
    <string name="about_booming_ss_upstream_summary">Vis upstream-prosjektet til Christians Martínez Alvarado og bidragsytere.</string>
    <string name="about_booming_music_original_author_title">Opprinnelig forfatter av Booming Music</string>
    <string name="about_booming_ss_report_bugs_dialog_message">Booming SS bruker sitt eget repository for kildeseparasjonsendringer og fork-spesifikke problemer. Hvis samme problem også skjer i den originale Booming Music-appen uten Booming SS-funksjoner, rapporter det til upstream-repositoriet i stedet.</string>
    <string name="about_booming_ss_translate_dialog_message">Lokaliseringen av original Booming Music administreres på Hosted Weblate. Det prosjektet inneholder ikke Booming SS-tekster for kildeseparasjon. Bruk denne lenken bare for oversettelser av upstream-appen. Booming SS-spesifikke oversettelser vedlikeholdes separat i denne forken.</string>
    <string name="source_separation_panel_entry_title">Tilgang til kildeseparasjonspanel</string>
    <string name="source_separation_panel_entry_summary">Vis avspillerknappen og menyelementet for kildeseparasjonspanelet.</string>
    <string name="source_separation_quick_controls_title">Hurtigkontroller for kildeseparasjon</string>
    <string name="source_separation_quick_controls_summary">Vis snarveien for spormiks over sangtekstene i avspilleren.</string>
