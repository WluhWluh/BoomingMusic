    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">Source separation fork</string>
    <string name="about_booming_ss_summary">Booming SS is an unofficial source-separation build based on Booming Music. It keeps the original local music player experience and adds separated playback, stem blend controls, per-song blend memory, and separated cache management.</string>
    <string name="about_booming_ss_model_title">Model files</string>
    <string name="about_booming_ss_model_summary">Source separation models are not bundled with the app. You can download a preset model, use a custom URL, or import a local TFLite file. Hash checks are shown as guidance and do not block use.</string>
    <string name="about_booming_ss_fork_title">Booming SS source code</string>
    <string name="about_booming_ss_fork_summary">Open this fork on GitHub for source-separation changes, releases, and issue reports. If the same issue also happens in the original Booming Music app, please report it to the upstream repository.</string>
    <string name="about_booming_ss_upstream_title">Original Booming Music</string>
    <string name="about_booming_ss_upstream_summary">View the upstream project by Christians Martínez Alvarado and contributors.</string>
    <string name="about_booming_music_original_author_title">Booming Music original author</string>
    <string name="about_booming_ss_report_bugs_dialog_message">Booming SS uses its own repository for source-separation changes and fork-specific issues. If the same issue also happens in the original Booming Music app without Booming SS features, please report it to the upstream repository instead.</string>
    <string name="about_booming_ss_translate_dialog_message">The original Booming Music localization is managed on Hosted Weblate. That project does not include Booming SS source-separation strings; use this link for upstream app translations only. Booming SS-specific translations are maintained separately in this fork.</string>
    <string name="source_separation_panel_entry_title">Source separation panel access</string>
    <string name="source_separation_panel_entry_summary">Show the player button and menu item for the source separation panel.</string>
    <string name="source_separation_quick_controls_title">Source separation quick controls</string>
    <string name="source_separation_quick_controls_summary">Show the stem blend shortcut over player lyrics.</string>
