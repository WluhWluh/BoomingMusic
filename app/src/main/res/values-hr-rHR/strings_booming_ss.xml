    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">Ogranak s razdvajanjem izvora</string>
    <string name="about_booming_ss_summary">Booming SS je neslužbena verzija temeljena na Booming Musicu s razdvajanjem izvora. Zadržava izvorno iskustvo lokalnog glazbenog reproduktora i dodaje odvojenu reprodukciju, kontrole miksa kanala, pamćenje miksa po pjesmi i upravljanje predmemorijama razdvajanja.</string>
    <string name="about_booming_ss_model_title">Datoteke modela</string>
    <string name="about_booming_ss_model_summary">Modeli za razdvajanje izvora nisu uključeni u aplikaciju. Možeš preuzeti unaprijed postavljeni model, upotrijebiti prilagođeni URL ili uvesti lokalnu ONNX datoteku. Provjere hasha prikazuju se samo kao smjernica i ne sprječavaju korištenje.</string>
    <string name="about_booming_ss_fork_title">Izvorni kod Booming SS-a</string>
    <string name="about_booming_ss_fork_summary">Otvori ovaj ogranak na GitHubu za promjene razdvajanja izvora, izdanja i prijave problema. Ako se isti problem pojavljuje i u izvornoj aplikaciji Booming Music, prijavi ga u repozitorij izvornog projekta.</string>
    <string name="about_booming_ss_upstream_title">Izvorni Booming Music</string>
    <string name="about_booming_ss_upstream_summary">Pogledaj izvorni projekt koji održavaju Christians Martínez Alvarado i doprinositelji.</string>
    <string name="about_booming_music_original_author_title">Izvorni autor Booming Musica</string>
    <string name="about_booming_ss_report_bugs_dialog_message">Booming SS koristi vlastiti repozitorij za promjene razdvajanja izvora i probleme specifične za ovaj ogranak. Ako se isti problem pojavljuje i u izvornoj aplikaciji Booming Music bez značajki Booming SS-a, prijavi ga umjesto toga u repozitorij izvornog projekta.</string>
    <string name="about_booming_ss_translate_dialog_message">Lokalizacija izvornog Booming Musica održava se na Hosted Weblateu. Taj projekt ne sadrži tekstove Booming SS-a povezane s razdvajanjem izvora. Ovu poveznicu koristi samo za prijevode izvorne aplikacije. Prijevodi specifični za Booming SS održavaju se zasebno u ovom ogranku.</string>
    <string name="source_separation_panel_entry_title">Pristup ploči razdvajanja izvora</string>
    <string name="source_separation_panel_entry_summary">Prikaži gumb reproduktora i stavku izbornika za ploču razdvajanja izvora.</string>
    <string name="source_separation_quick_controls_title">Brze kontrole razdvajanja izvora</string>
    <string name="source_separation_quick_controls_summary">Prikaži prečac za miks kanala iznad teksta pjesme u reproduktoru.</string>
