    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">פורק להפרדת מקורות שמע</string>
    <string name="about_booming_ss_summary">Booming SS הוא גרסה לא רשמית המבוססת על Booming Music עם הפרדת מקורות שמע. הוא שומר על חוויית נגן המוזיקה המקומית המקורית ומוסיף השמעה מופרדת, בקרות מיקס סטמים, זיכרון מיקס לכל שיר וניהול מטמוני הפרדה.</string>
    <string name="about_booming_ss_model_title">קובצי מודל</string>
    <string name="about_booming_ss_model_summary">מודלי הפרדת מקורות שמע אינם כלולים באפליקציה. אפשר להוריד מודל קבוע מראש, להשתמש בכתובת URL מותאמת אישית או לייבא קובץ TFLite מקומי. בדיקות גיבוב מוצגות כהנחיה בלבד ואינן חוסמות שימוש.</string>
    <string name="about_booming_ss_fork_title">קוד המקור של Booming SS</string>
    <string name="about_booming_ss_fork_summary">פתח את הפורק הזה ב-GitHub כדי לראות שינויים בהפרדת מקורות שמע, גרסאות ודיווחי בעיות. אם אותה בעיה מתרחשת גם באפליקציית Booming Music המקורית, נא לדווח עליה למאגר של הפרויקט המקורי.</string>
    <string name="about_booming_ss_upstream_title">Booming Music המקורי</string>
    <string name="about_booming_ss_upstream_summary">צפה בפרויקט המקורי שמתוחזק על ידי Christians Martínez Alvarado ותורמים.</string>
    <string name="about_booming_music_original_author_title">היוצר המקורי של Booming Music</string>
    <string name="about_booming_ss_report_bugs_dialog_message">Booming SS משתמש במאגר משלו לשינויי הפרדת מקורות שמע ולבעיות ייחודיות לפורק הזה. אם אותה בעיה מתרחשת גם ב-Booming Music המקורי ללא תכונות Booming SS, נא לדווח עליה למאגר המקורי במקום זאת.</string>
