    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">Fork con separación de fuentes</string>
    <string name="about_booming_ss_summary">Booming SS es una versión no oficial basada en Booming Music con separación de fuentes. Mantiene la experiencia original del reproductor de música local y añade reproducción separada, controles de mezcla de pistas, memoria de mezcla por canción y gestión de cachés separadas.</string>
    <string name="about_booming_ss_model_title">Archivos de modelo</string>
    <string name="about_booming_ss_model_summary">Los modelos de separación de fuentes no se incluyen con la aplicación. Puedes descargar un modelo predefinido, usar una URL personalizada o importar un archivo TFLite local. Las comprobaciones de hash se muestran como orientación y no bloquean el uso.</string>
    <string name="about_booming_ss_fork_title">Código fuente de Booming SS</string>
    <string name="about_booming_ss_fork_summary">Abre este fork en GitHub para consultar cambios de separación de fuentes, versiones e informes de problemas. Si el mismo problema también ocurre en la aplicación Booming Music original, infórmalo en el repositorio principal.</string>
    <string name="about_booming_ss_upstream_title">Booming Music original</string>
    <string name="about_booming_ss_upstream_summary">Ver el proyecto principal de Christians Martínez Alvarado y colaboradores.</string>
    <string name="about_booming_music_original_author_title">Autor original de Booming Music</string>
    <string name="about_booming_ss_report_bugs_dialog_message">Booming SS usa su propio repositorio para los cambios de separación de fuentes y los problemas específicos del fork. Si el mismo problema también ocurre en la aplicación Booming Music original sin funciones de Booming SS, infórmalo mejor en el repositorio principal.</string>
    <string name="about_booming_ss_translate_dialog_message">La localización del Booming Music original se gestiona en Hosted Weblate. Ese proyecto no incluye las cadenas de separación de fuentes de Booming SS; usa este enlace solo para traducciones de la aplicación principal. Las traducciones específicas de Booming SS se mantienen por separado en este fork.</string>
    <string name="source_separation_panel_entry_title">Acceso al panel de separación de fuentes</string>
    <string name="source_separation_panel_entry_summary">Muestra el botón del reproductor y el elemento de menú del panel de separación de fuentes.</string>
    <string name="source_separation_quick_controls_title">Controles rápidos de separación de fuentes</string>
    <string name="source_separation_quick_controls_summary">Muestra el acceso directo de mezcla de pistas sobre la letra en el reproductor.</string>
