    <string name="source_separation_panel_entry_summary">Player-Schaltfläche und Menüeintrag für den Quellentrennungsbereich anzeigen.</string>
    <string name="source_separation_quick_controls_title">Schnellsteuerung für Quellentrennung</string>
    <string name="source_separation_quick_controls_summary">Kurzbefehl für die Spurmischung über den Liedtexten im Player anzeigen.</string>
