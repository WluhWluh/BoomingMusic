    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">Fork com separação de fontes</string>
    <string name="about_booming_ss_summary">O Booming SS é uma versão não oficial com separação de fontes baseada no Booming Music. Mantém a experiência original de reprodutor de música local e adiciona reprodução separada, controlos de mistura de faixas, memória de mistura por música e gestão de caches separadas.</string>
    <string name="about_booming_ss_model_title">Ficheiros de modelo</string>
    <string name="about_booming_ss_model_summary">Os modelos de separação de fontes não são incluídos na aplicação. Pode transferir um modelo pré-definido, usar um URL personalizado ou importar um ficheiro ONNX local. As verificações de hash são apresentadas apenas como orientação e não bloqueiam a utilização.</string>
    <string name="about_booming_ss_fork_title">Código-fonte do Booming SS</string>
    <string name="about_booming_ss_fork_summary">Abra este fork no GitHub para ver alterações de separação de fontes, lançamentos e relatórios de problemas. Se o mesmo problema também acontecer na aplicação Booming Music original, reporte-o ao repositório upstream.</string>
    <string name="about_booming_ss_upstream_title">Booming Music original</string>
    <string name="about_booming_ss_upstream_summary">Veja o projeto upstream de Christians Martínez Alvarado e colaboradores.</string>
    <string name="about_booming_music_original_author_title">Autor original do Booming Music</string>
    <string name="about_booming_ss_report_bugs_dialog_message">O Booming SS usa o seu próprio repositório para alterações de separação de fontes e problemas específicos do fork. Se o mesmo problema também acontecer na aplicação Booming Music original sem as funcionalidades do Booming SS, reporte-o ao repositório upstream.</string>
    <string name="about_booming_ss_translate_dialog_message">A localização do Booming Music original é gerida no Hosted Weblate. Esse projeto não inclui as strings de separação de fontes do Booming SS; use esta ligação apenas para traduções da aplicação upstream. As traduções específicas do Booming SS são mantidas separadamente neste fork.</string>
    <string name="source_separation_panel_entry_title">Acesso ao painel de separação de fontes</string>
    <string name="source_separation_panel_entry_summary">Mostrar o botão do reprodutor e o item de menu do painel de separação de fontes.</string>
    <string name="source_separation_quick_controls_title">Controlos rápidos de separação de fontes</string>
    <string name="source_separation_quick_controls_summary">Mostrar o atalho de mistura de faixas sobre as letras no reprodutor.</string>
