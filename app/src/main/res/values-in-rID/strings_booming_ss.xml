    <string name="source_separation_panel_entry_summary">Tampilkan tombol pemutar dan item menu untuk panel pemisahan sumber.</string>
    <string name="source_separation_quick_controls_title">Kontrol cepat pemisahan sumber</string>
    <string name="source_separation_quick_controls_summary">Tampilkan pintasan campuran stem di atas lirik pemutar.</string>
