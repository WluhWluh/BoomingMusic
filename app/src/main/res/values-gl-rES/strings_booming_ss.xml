    <string name="about_booming_ss_title">Booming SS</string>
    <string name="about_booming_ss_summary_title">Versión derivada con separación de fontes</string>
    <string name="about_booming_ss_summary">Booming SS é unha versión non oficial baseada en Booming Music con separación de fontes. Mantén a experiencia orixinal de reprodutor de música local e engade reprodución separada, controis de mestura de pistas, memoria de mestura por canción e xestión de cachés separadas.</string>
    <string name="about_booming_ss_model_title">Ficheiros de modelo</string>
    <string name="about_booming_ss_model_summary">Os modelos de separación de fontes non se inclúen coa aplicación. Podes descargar un modelo predefinido, usar un URL personalizado ou importar un ficheiro TFLite local. As comprobacións de hash móstranse só como orientación e non bloquean o uso.</string>
    <string name="about_booming_ss_fork_title">Código fonte de Booming SS</string>
    <string name="about_booming_ss_fork_summary">Abre esta versión derivada en GitHub para ver cambios de separación de fontes, versións e informes de problemas. Se o mesmo problema tamén acontece na aplicación Booming Music orixinal, infórmao no repositorio principal.</string>
    <string name="about_booming_ss_upstream_title">Booming Music orixinal</string>
    <string name="about_booming_ss_upstream_summary">Ver o proxecto principal de Christians Martínez Alvarado e colaboradores.</string>
    <string name="about_booming_music_original_author_title">Autor orixinal de Booming Music</string>
    <string name="about_booming_ss_report_bugs_dialog_message">Booming SS usa o seu propio repositorio para os cambios de separación de fontes e os problemas específicos desta versión derivada. Se o mesmo problema tamén acontece na aplicación Booming Music orixinal sen funcións de Booming SS, infórmao mellor no repositorio principal.</string>
    <string name="about_booming_ss_translate_dialog_message">A localización do Booming Music orixinal xestiónase en Hosted Weblate. Ese proxecto non inclúe as cadeas de separación de fontes de Booming SS; usa esta ligazón só para traducións da aplicación principal. As traducións específicas de Booming SS mantéñense por separado nesta versión derivada.</string>
    <string name="source_separation_panel_entry_title">Acceso ao panel de separación de fontes</string>
    <string name="source_separation_panel_entry_summary">Mostra o botón do reprodutor e o elemento de menú para o panel de separación de fontes.</string>
    <string name="source_separation_quick_controls_title">Controis rápidos de separación de fontes</string>
    <string name="source_separation_quick_controls_summary">Mostra o atallo de mestura de pistas sobre a letra no reprodutor.</string>
